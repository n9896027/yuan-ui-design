.sheet { padding: 44rpx 30rpx 72rpx; }.eyebrow,.time { color:#6f6253; font-size:24rpx; letter-spacing:2rpx; }.title { font-size:68rpx; line-height:1.2; margin-top:24rpx; font-family:serif; }.subtitle { font-size:30rpx; margin-top:12rpx; }.note { color:#605b51; font-size:25rpx; line-height:1.7; margin-top:28rpx; }.rule { height:2rpx; background:#1f2827; margin:36rpx 0 8rpx; }.film { display:flex; gap:22rpx; padding:26rpx 0; border-bottom:1rpx solid #cfc4b1; }.still { width:200rpx; height:144rpx; background:#ddd; }.film-copy { flex:1; min-width:0; }.film-title { font-size:37rpx; line-height:1.3; margin-top:8rpx; }.star { font-size:20rpx; color:#9d341d; border:1rpx solid #9d341d; padding:2rpx 8rpx; margin-left:8rpx; }.original,.caption { color:#665e51; font-size:23rpx; margin-top:7rpx; }.caption { line-height:1.5; }

<view wx:if="{{film}}" class="page"><image class="hero" src="/{{film.image}}" mode="{{film.delivery.detail.mode}}" aria-label="{{film.alt}}"/><view class="time">{{film.time}} — {{film.end}} · {{film.year}}</view><view class="title">{{film.title}}</view><view class="original">{{film.original}}</view><view class="caption">{{film.caption}}</view><view class="credit">导演／创作者：{{film.credit}}</view><button class="favorite" bindtap="toggleFavorite">{{favorite ? '移除收藏' : '收藏影片'}}</button><button class="share" open-type="share">转发这部影片</button><view wx:if="{{status}}" role="status">{{status}}</view><view class="storage-note">收藏只保存在此设备的微信本地存储中，不会跨设备同步。</view></view>
<view wx:else class="page">{{status}}<button bindtap="openProgramme">返回节目单</button></view>
